# ---------- Frontend (Vite, build-time) ----------
# Where the signaling WebSocket lives. Leave empty in development: the Vite dev
# server proxies /ws to the local signaling server.
# Production example: wss://signal.beamdrop.example/ws
VITE_SIGNALING_URL=

# ---------- Signaling server (Node, runtime) ----------
PORT=8787
# Comma-separated list of origins allowed to open a WebSocket. Empty = allow all
# (fine for local development, set it in production).
ALLOWED_ORIGINS=
# Set to 1 when running behind a reverse proxy / platform load balancer so the
# client IP comes from X-Forwarded-For (used for rate limiting).
TRUST_PROXY=0

# Optional TURN relay (coturn with `use-auth-secret`). When both are set the
# signaling server hands each session short-lived relay credentials, so no
# long-lived secret ever ships to the browser.
TURN_URLS=
TURN_SECRET=
